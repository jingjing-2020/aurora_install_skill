# Copy this file to config/aurora_server.env and edit it on the server.
# Do not commit config/aurora_server.env.

# Root directory for Aurora helper environments and caches.
SERVER_ROOT="${HOME}/aurora_server"

# DTK PyTorch Python observed in the verified Hygon DCU environment.
# Change this if your cluster exposes a different Python path.
DTK_PYTHON="/public/software/apps/DeepLearning/PyTorch/pytorch-2.1.0-dtk23.10/build/bin/python3"

# Isolated package overlays. These are added to PYTHONPATH by the bootstrap script.
AURORA_PY38="${SERVER_ROOT}/aurora_py38"
CAMS_TOOLS="${SERVER_ROOT}/cams_tools"
HF_CACHE="${SERVER_ROOT}/hf_cache/hub"

# Module stack observed in the verified environment.
# Change these names to match `module avail` on your cluster.
LOAD_MODULES=1
AURORA_MODULES="compiler/devtoolset/7.3.1 mpi/openmpi/4.0.4/gcc-7.3.1 compiler/dtk/23.10 apps/PyTorch/dtk-23.10/2.1.0a0"

# Package install switches.
INSTALL_AURORA=1
INSTALL_DOWNLOAD_TOOLS=1
RUN_IMPORT_CHECKS=1

# Aurora package version used by the verified workflow.
AURORA_VERSION="2.0.0"

# Keep torch out of these overlays so the DTK PyTorch build is not shadowed.
AURORA_BASE_PACKAGE="microsoft-aurora==${AURORA_VERSION}"
AURORA_BASE_PIP_FLAGS="--upgrade --no-deps"
AURORA_EXTRA_PACKAGES="xarray netCDF4 numpy pandas einops timm safetensors huggingface_hub requests"
DOWNLOAD_TOOL_PACKAGES="cdsapi huggingface_hub requests"

# Credentials must be exported in the shell or stored in protected files outside git.
# Example:
#   export ADS_API_KEY="..."
#   export CDSAPI_RC="${HOME}/.cdsapirc"

